+
+/**
+ * Each circle's ＋ nub (P-62): sticking out of its edge at the first angle (`ANGLES`) where its disc
+ * stays inside the picture and clear of every other circle and its rings, every label, every step
+ * mark (and its words and branch), every branch, "and more →" and the nubs placed before it. Its
+ * 44 px target is kept inside the picture. With no angle clear, the first that stays inside.
+ */
+export function nubs(layout: OverviewLayout, width: number): Record<Id, Nub> {
+  if (layout.summaryOnly) return {};
+  const key = nubKey(layout, width);
+  if (last?.key === key) return last.out;
+  const out = placeNubs(layout, width);
+  last = { key, out };
+  return out;
+}
+
+function placeNubs(layout: OverviewLayout, width: number): Record<Id, Nub> {
+  const out: Record<Id, Nub> = {};
+  const { discs, boxes, polys, lines, targets } = obstacles(layout, width);
+  const R = NUB_R + CLEAR;
+  const placed: Nub[] = [];
+  for (const n of layout.nodes) {
+    const c = n.circle;
+    if (!c) continue;
+    const inside = (p: { x: number; y: number }) => p.x - NUB_R >= 0 && p.x + NUB_R <= width && p.y - NUB_R >= 0 && p.y + NUB_R <= layout.height;
+    // The target reaches out from the circle along the nub's angle until it leaves the circle's middle
+    // (a tap there is the circle's), then stays inside the picture.
+    const hitAt = (a: number): Nub => {
+      const p = at(c, a);
+      const box = (k: number) => ({
+        x: Math.max(0, Math.min(width - NUB_HIT, c.cx + Math.cos(a) * k - NUB_HIT / 2)),
+        y: Math.max(0, Math.min(layout.height - NUB_HIT, c.cy + Math.sin(a) * k - NUB_HIT / 2)),
+        w: NUB_HIT,
+        h: NUB_HIT,
+      });
+      let d = c.r + NUB_OUT;
+      while (d < c.r + NUB_OUT + NUB_HIT && discTouchesBox(c.cx, c.cy, middle(c.r) + 1, box(d))) d += 1;
+      const b = box(d);
+      return { ...p, hx: b.x, hy: b.y };
+    };
+    const others = discs.filter((d) => d.x !== c.cx || d.y !== c.cy);
+    const clear = (q: Nub) => {
+      const hit = { x: q.hx, y: q.hy, w: NUB_HIT, h: NUB_HIT };
+      return (
+        inside(q) &&
+        !discTouchesBox(c.cx, c.cy, middle(c.r), hit) &&
+        discTouchesBox(q.x, q.y, 0.5, hit) &&
+        others.every((d) => Math.hypot(q.x - d.x, q.y - d.y) >= d.r + R && !discTouchesBox(d.x, d.y, d.r - RING_OUT, hit)) &&
+        boxes.every((b) => !discTouchesBox(q.x, q.y, R, b)) &&
+        targets.every((b) => !overlaps(hit, b)) &&
+        polys.every((poly) => !discTouchesPolygon(q.x, q.y, R, poly)) &&
+        lines.every((line) => !discTouchesLine(q.x, q.y, R + BRANCH_HALF, line)) &&
+        placed.every((o) => Math.hypot(q.x - o.x, q.y - o.y) >= 2 * R && !overlaps(hit, { x: o.hx, y: o.hy, w: NUB_HIT, h: NUB_HIT }))
+      );
+    };
+    const cands = ANGLES.map(hitAt);
+    const q = cands.find(clear) ?? cands.find(inside) ?? cands[0];
+    placed.push(q);
+    out[n.id] = { x: r1(q.x), y: r1(q.y), hx: r1(q.hx), hy: r1(q.hy) };
+  }
+  return out;
+}
+
+/** The actions strip's widest. */
+export const MENU_MAX_W = 352;
+/** Between the circle's outermost ring and the strip. */
+const MENU_GAP = 4;
+
+/**
+ * Where a node's actions strip goes (P-62), `w` × `h`, in a picture `area.w` × `area.h`: under the
+ * circle's rings, centred on it; flipped above when it doesn't fit below; kept inside the picture
+ * either way (it covers the band of labels under the row, never a circle of the other row).
+ */
+export function menuPlace(c: { cx: number; cy: number; r: number }, size: { w: number; h: number }, area: { w: number; h: number }): { x: number; y: number; above: boolean } {
+  const w = Math.min(size.w, area.w);
+  const x = Math.max(0, Math.min(area.w - w, c.cx - w / 2));
+  const below = c.cy + c.r + RING_OUT + MENU_GAP;
+  if (below + size.h <= area.h) return { x: r1(x), y: r1(below), above: false };
+  const above = c.cy - c.r - RING_OUT - MENU_GAP - size.h;
+  if (above >= 0) return { x: r1(x), y: r1(above), above: true };
+  return { x: r1(x), y: r1(Math.max(0, Math.min(area.h - size.h, below))), above: false };
+}
+
+/** The node's circle in a layout, for placing its actions. */
+export const circleOf = (layout: OverviewLayout, id: Id): LaidNode['circle'] => layout.nodes.find((n) => n.id === id)?.circle;
