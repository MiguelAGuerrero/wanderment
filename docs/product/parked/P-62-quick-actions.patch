+/**
+ * P-62 (D-11): quick actions on a node. Every circle on Home has a small ＋ nub sticking out of its
+ * edge; selecting a node (or its nub) pops up its actions as a compact strip beside it. Nothing here
+ * is stored.
+ */
+import { stepMark } from './focus';
+import { LABEL_LINE, LaidNode, OverviewLayout, RING_OUT } from './overview';
+import { Id } from './types';
+
+/** The nub's visual radius (a 20 pt disc)… */
+export const NUB_R = 10;
+/** …its centre this far beyond the circle's edge, so it overlaps the edge and sticks out… */
+export const NUB_OUT = 4;
+/** …and its pointer target (overlapping the circle's edge). */
+export const NUB_HIT = 44;
+/** The middle of a circle a nub's target never covers (a tap there is the circle's): this much of its radius. */
+export const middle = (r: number) => 0.6 * r;
+/** The least room between the nub and anything else drawn. */
+const CLEAR = 2;
+
+export interface Nub {
+  /** The nub's centre. */
+  x: number;
+  y: number;
+  /** Its 44 × 44 target's top-left corner (kept inside the picture, so not always centred on the nub). */
+  hx: number;
+  hy: number;
+}
+
+type Box = { x: number; y: number; w: number; h: number };
+const DEG = Math.PI / 180;
+/**
+ * Where a nub may go, in order of preference (screen angles, y down): upper right, upper left, right,
+ * left, straight up, then the lower diagonals. Labels and the step band are below a circle and
+ * branches mostly leave toward the other row, so an upper diagonal is nearly always free.
+ */
+const ANGLES = [-45, -135, 0, 180, -90, 45, 135].map((a) => a * DEG);
+
+const r1 = (n: number) => Math.round(n * 10) / 10;
+
+/** Whether a disc comes within `R` of a box. */
+export function discTouchesBox(cx: number, cy: number, R: number, b: Box): boolean {
+  const dx = Math.max(b.x - cx, 0, cx - (b.x + b.w));
+  const dy = Math.max(b.y - cy, 0, cy - (b.y + b.h));
+  return dx * dx + dy * dy < R * R;
+}
+
+const overlaps = (a: Box, b: Box) => a.x < b.x + b.w - 0.01 && b.x < a.x + a.w - 0.01 && a.y < b.y + b.h - 0.01 && b.y < a.y + a.h - 0.01;
+
+/** Distance from a point to a segment. */
+function segDist(px: number, py: number, ax: number, ay: number, bx: number, by: number): number {
+  const vx = bx - ax;
+  const vy = by - ay;
+  const l = vx * vx + vy * vy;
+  const t = l ? Math.max(0, Math.min(1, ((px - ax) * vx + (py - ay) * vy) / l)) : 0;
+  return Math.hypot(px - (ax + t * vx), py - (ay + t * vy));
