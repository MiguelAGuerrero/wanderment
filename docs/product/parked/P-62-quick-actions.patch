+++ b/src/domain/activityIndex.test.ts
@@ -0,0 +1,102 @@
+/** P-46 (with P-62): Home's index of every log, brought up to date a log at a time, always equals one built from scratch. */
+import { describe, expect, it } from 'vitest';
+
+import { activityIndex, ActivityIndex, buildActivityIndex, newer, TOP_PER_THREAD } from './activityIndex';
+import { deleteActivity, editActivity, ensureThread, logActivity } from './model';
+import { headerWhys, looseLogs, overview } from './overview';
+import { Data, emptyData, Id } from './types';
+
+const NOW = new Date(Date.UTC(2026, 10, 23, 12));
+const day = (n: number) => new Date(NOW.getTime() - n * 864e5);
+
+/** Everything an index says, comparable. */
+const plain = (ix: ActivityIndex) => ({
+  count: ix.count,
+  steps: [...ix.steps].sort(),
+  pairs: [...ix.pairs].map(([k, m]) => [k, [...m].sort()]).sort(),
+  direct: [...ix.direct].sort(),
+  top: [...ix.top].map(([k, l]) => [k, l.map((a) => a.id)]).sort(),
+  latest: [...ix.heat.latest].sort(),
+  feeders: [...ix.heat.feeders].map(([k, s]) => [k, [...s].sort()]).sort(),
+  loose: ix.loose.map((a) => a.id).sort(),
+});
+
+function world() {
+  let data: Data = emptyData();
+  const id: Id[] = [];
+  for (let i = 0; i < 8; i++) {
+    const r = ensureThread(data, `w${i}`, day(300));
+    data = r.data;
+    id.push(r.thread.id);
+  }
+  let seed = 7;
+  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
+  for (let i = 0; i < 60; i++) {
+    const doing = rnd() < 0.8 ? id[Math.floor(rnd() * 8)] : undefined;
+    const to = rnd() < 0.7 ? [id[Math.floor(rnd() * 8)]] : [];
+    data = logActivity(data, { text: `x${i}`, doingId: doing, toIds: to, occurredAt: day(rnd() * 30) }, day(rnd() * 30)).data;
+  }
+  return { data, id };
+}
+
+/** Worked out the slow way, log by log: each wander's newest logs, its counts, the loose ones. */
+function oracle(data: Data) {
+  const acts = Object.values(data.activities);
+  const ids = [...new Set(acts.flatMap((a) => [...(a.doingId ? [a.doingId] : []), ...a.toIds]))];
+  const names = (a: (typeof acts)[number], id: Id) => a.doingId === id || a.toIds.includes(id);
+  return {
+    top: ids.map((id) => [id, acts.filter((a) => names(a, id)).sort(newer).slice(0, TOP_PER_THREAD).map((a) => a.id)]).sort(),
+    steps: ids.map((id) => [id, acts.filter((a) => a.doingId === id || (a.toIds.includes(id) && a.doingId !== id)).length]).sort(),
+    loose: acts.filter((a) => !a.doingId && !a.toIds.length).map((a) => a.id).sort(),
+  };
+}
+
+const expectSame = (data: Data, what: string) => {
+  const p = plain(activityIndex(data.activities));
+  expect(p, what).toEqual(plain(buildActivityIndex(data.activities)));
+  const o = oracle(data);
+  expect(p.top, what).toEqual(o.top);
+  expect(p.steps, what).toEqual(o.steps);
+  expect(p.loose, what).toEqual(o.loose);
+  // And so the picture and the loose logs are what a fresh index gives.
+  const ov = overview(data, headerWhys(data, NOW), { now: NOW });
+  const l = looseLogs(data, { now: NOW });
+  activityIndex({}); // forgotten: the next one is worked out afresh (every record added to an empty index)
+  expect(ov, what).toEqual(overview(data, headerWhys(data, NOW), { now: NOW }));
+  expect(l, what).toEqual(looseLogs(data, { now: NOW }));
+};
+
+describe('P-46: the activity index', () => {
+  it('a log at a time (with a doing, a to, both, neither), it matches one built from scratch, and the picture with it', () => {
+    let { data, id } = world();
+    expectSame(data, 'start');
+    for (const [i, input] of [{ doingId: id[1], toIds: [id[2]] }, { toIds: [id[3]] }, { doingId: id[4], toIds: [] }, { toIds: [] }, { doingId: id[5], toIds: [id[5], id[0]] }].entries()) {
+      const before = activityIndex(data.activities);
+      // The picture worked out with it before the log (so a stale answer would show).
+      overview(data, headerWhys(data, NOW), { now: NOW });
+      data = logActivity(data, { text: `new ${i}`, ...input }, day(0)).data;
+      expect(activityIndex(data.activities), 'brought up to date, not rebuilt').toBe(before);
+      expectSame(data, `log ${i}`);
+    }
+  });
+
+  it('an edit, a removal or a replaced history builds it again, correctly', () => {
+    let { data } = world();
+    activityIndex(data.activities);
+    const [a, b] = Object.keys(data.activities);
+    data = editActivity(data, a, { toIds: [], doingId: null });
+    expectSame(data, 'edited');
+    data = deleteActivity(data, b);
+    expectSame(data, 'removed');
+    // Undo of a log: the older activities again.
+    const older = data;
+    data = logActivity(data, { text: 'undone', toIds: [] }, day(0)).data;
+    activityIndex(data.activities);
+    expectSame(older, 'undone');
+    // One more record, but another one changed in the same step: rebuilt.
+    const ids = Object.keys(older.activities);
+    const tampered = { ...older, activities: { ...older.activities, [ids[0]]: { ...older.activities[ids[0]], toIds: [] }, extra: { ...older.activities[ids[1]], id: 'extra' } } };
+    activityIndex(older.activities);
+    expectSame(tampered, 'one more and one changed');
+  });
+});
