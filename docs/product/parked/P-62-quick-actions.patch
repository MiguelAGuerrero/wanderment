+/** The way back to what opened a node's actions (web): its circle, its ＋ nub, or its button in the list. */
+const opener = (id: Id, by: 'node' | 'nub') => {
+  if (!web || typeof document === 'undefined') return null;
+  const q = (t: string) => document.querySelector<HTMLElement>(`[data-testid="${CSS.escape(t)}"]`);
+  return by === 'nub' ? q(`graph-nub-${id}`) : (q(`graph-node-${id}`) ?? q(`graph-item-${id}`));
+};
+
+/** Focus back on what opened the actions (Esc, Back). */
+export const returnFocus = (id: Id, by: 'node' | 'nub') => requestAnimationFrame(() => focusEl(opener(id, by)));
+
+/** One action: an icon over a short label (the label is its name), 48 pt tall. */
+const ITEM_W = 88;
+
+/**
+ * P-62 (D-11): a node's quick actions, popped up by selecting it (or its ＋ nub): a compact strip of
+ * Log toward it · ＋ Under it · Add a step (while it has none) · Open. A menu of menuitems (arrow
+ * keys move between them on web); focus goes to the first when it opens. "＋ Under it" turns the
+ * strip into a name field: Return makes the new wander and opens the log field with it as doing and
+ * this node as "to" (chips), so the first log draws the branch — nothing is logged or stored until
+ * then (a stored pending home waits for P-53). Esc, Back, a tap outside or another node put it away
+ * (`HomeGraph`).
+ */
+export function NodeActions({ id, name, style, onSize }: { id: Id; name: string; style?: object; onSize?: (size: { w: number; h: number }) => void }) {
+  const hasStep = useStore((st) => !!st.data.threads[id]?.next);
+  const [naming, setNaming] = useState(false);
+  const [text, setText] = useState('');
+  const items = useRef<Focusable[]>([]);
+  const box = useRef<Focusable>(null);
+  // Focus goes in (web): the first action, as soon as it's there (before a key pressed meanwhile can go elsewhere).
+  useLayoutEffect(() => {
+    if (web && !naming) focusEl(items.current[0]);
+  }, [naming]);
+  // Focus leaving for somewhere else on the page puts it away (Tab out, the log field taking it).
+  useEffect(() => {
+    if (!web) return;
+    const el = box.current as unknown as HTMLElement | null;
+    // Back on its own circle, nub or list button (Shift+Tab), they stay: activating it again is the second tap.
+    const onOut = (e: FocusEvent) => {
+      const to = e.relatedTarget as Node | null;
+      if (to && !el?.contains(to) && !(['node', 'nub'] as const).some((by) => opener(id, by)?.contains(to))) useStore.getState().showActions(undefined);
+    };
+    el?.addEventListener('focusout', onOut);
+    return () => el?.removeEventListener('focusout', onOut);
+  }, [id]);
+
+  const close = () => useStore.getState().showActions(undefined);
+  const logToward = () => {
+    const st = useStore.getState();
+    close();
+    st.select(id);
+    st.focusLogBox();
+  };
+  const under = () => {
+    const n = text.trim();
+    if (!n) return;
+    const st = useStore.getState();
+    // Refused while reconnecting: the name stays.
+    const made = st.createThread(n);
+    if (!made) return;
+    close();
+    if (made !== id) st.setDraft({ doingId: made });
+    st.select(id);
+    st.focusLogBox();
+  };
+  const addStep = () => {
+    close();
+    useStore.getState().askAddStep(id);
+  };
+  const open = () => {
+    close();
+    router.push(`/thread/${id}`);
+  };
+  const actions = [
+    { key: 'log', glyph: '→', label: 'Log toward it', run: logToward },
+    { key: 'under', glyph: '＋', label: 'Under it', run: () => setNaming(true) },
+    ...(hasStep ? [] : [{ key: 'step', glyph: '•', label: 'Add a step', run: addStep }]),
+    { key: 'open', glyph: '↗', label: 'Open', run: open },
+  ];
+  const onKeyDown = (e: { key: string; preventDefault(): void }) => {
+    const all = items.current.filter(Boolean) as unknown as HTMLElement[];
+    const i = all.indexOf(document.activeElement as HTMLElement);
+    const to = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: all.length - 1 }[e.key];
+    if (to === undefined) return;
+    e.preventDefault();
+    all[(to + all.length) % all.length]?.focus();
+  };
+  const onLayout = (e: LayoutChangeEvent) => onSize?.({ w: e.nativeEvent.layout.width, h: e.nativeEvent.layout.height });
+
+  return (
+    <View ref={box} testID="node-actions" style={[styles.strip, { width: Math.min(MENU_MAX_W, actions.length * ITEM_W) }, style]} onLayout={onLayout}>
+      {naming ? (
+        <View role="group" aria-label={`New wander under ${name}`} style={styles.naming}>
+          <Text style={styles.glyph} {...decorative}>
+            ＋
+          </Text>
+          <TextInput
+            value={text}
+            onChangeText={setText}
+            autoFocus
+            placeholder="New wander under it"
+            placeholderTextColor={C.faint}
+            onSubmitEditing={under}
+            submitBehavior="submit"
+            blurOnSubmit={false}
+            returnKeyType="done"
+            style={styles.field}
+            accessibilityLabel={`New wander under ${name}`}
+            testID="node-actions-under"
+          />
+        </View>
+      ) : (
+        <View role="menu" aria-label={`Actions for ${name}`} {...({ 'aria-orientation': 'horizontal' } as object)} style={styles.row} {...(web && ({ onKeyDown } as object))}>
+          {actions.map((a, i) => (
+            <Pressable
+              key={a.key}
+              ref={(el) => {
+                items.current[i] = el;
+              }}
+              role="menuitem"
+              onPress={a.run}
+              testID={`node-action-${a.key}`}
+              {...(web && ({ tabIndex: i === 0 ? 0 : -1 } as object))}
+              style={({ pressed }) => [styles.item, pressed && styles.pressed]}>
+              <Text style={styles.glyph} {...decorative}>
+                {a.glyph}
+              </Text>
+              <Text style={styles.label} numberOfLines={2}>
+                {a.label}
+              </Text>
+            </Pressable>
+          ))}
+        </View>
+      )}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  strip: {
+    maxWidth: '100%',
+    backgroundColor: C.surface,
+    borderWidth: 1.5,
+    borderColor: C.ink,
+    borderRadius: 14,
+    overflow: 'hidden',
+    ...(web ? ({ boxShadow: '0 4px 14px rgba(24, 24, 27, 0.14)' } as object) : { elevation: 4 }),
+  },
+  // Wraps when there's no room for one line (the list at the largest text).
+  row: { flexDirection: 'row', flexWrap: 'wrap' },
+  item: { flexGrow: 1, flexBasis: ITEM_W - 8, minWidth: 44, minHeight: 52, paddingHorizontal: 4, paddingVertical: 5, alignItems: 'center', justifyContent: 'center', gap: 1 },
+  pressed: { backgroundColor: C.quietBg },
+  glyph: { fontSize: 16, lineHeight: 19, color: C.ink, fontWeight: '600' },
+  label: { fontSize: 12, lineHeight: 14, color: C.ink, fontWeight: '500', textAlign: 'center' },
+  naming: { flexDirection: 'row', alignItems: 'center', gap: 6, minHeight: 52, paddingLeft: 12, paddingRight: 8 },
+  field: { flex: 1, minHeight: 44, fontSize: 15, color: C.ink },
+});
