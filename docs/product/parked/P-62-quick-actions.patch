+/** P-62: selecting a node pops up its quick actions; a second tap narrows (and puts them away). */
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { FocusMap } from '@/domain/focus';
+import { emptyData, Id } from '@/domain/types';
+
+import { useStore } from './useStore';
+
+const st = () => useStore.getState();
+
+beforeEach(() => {
+  useStore.setState({ data: emptyData(), undo: undefined, toast: undefined, selected: undefined, focus: undefined, scope: [], focusMap: undefined, actionsFor: undefined, homeFace: 'next', draft: { text: '', toIds: [] } });
+});
+
+/** make apparel ← draw, make apparel ← sew; guitar alone. */
+function world() {
+  const id: Record<string, Id> = {};
+  for (const n of ['make apparel', 'draw', 'sew', 'guitar']) id[n] = st().createThread(n);
+  const map: FocusMap = {
+    nodes: [
+      { id: id['make apparel'], name: 'make apparel', x: 60, y: 50, why: true },
+      { id: id.guitar, name: 'guitar', x: 240, y: 50, why: false },
+      { id: id.draw, name: 'draw', x: 34, y: 140, why: false },
+      { id: id.sew, name: 'sew', x: 94, y: 140, why: false },
+    ],
+    links: [
+      { from: id.draw, to: id['make apparel'] },
+      { from: id.sew, to: id['make apparel'] },
+    ],
+  };
+  st().setFocusMap(map);
+  return id;
+}
+
+describe('P-62: selecting a node', () => {
+  it('a tap focuses it and pops up its actions (said like a focus), without attaching or narrowing', () => {
+    const id = world();
+    const n = st().focusSaid.n;
+    st().pressNode(id.draw);
+    expect(st().actionsFor).toBe(id.draw);
+    expect(st().focus).toBe(id.draw);
+    expect(st().focusSaid).toEqual({ text: 'What’s next, draw, for make apparel', n: n + 1 });
+    expect(st().selected).toBeUndefined();
+    expect(st().draft.toIds).toEqual([]);
+    expect(st().scope).toEqual([]);
+  });
+
+  it('a tap on the focused parent first pops up its actions; the second narrows and puts them away; another node moves them', () => {
+    const id = world();
+    useStore.setState({ focus: id['make apparel'] });
+    st().pressNode(id['make apparel']);
+    expect(st().actionsFor).toBe(id['make apparel']);
+    expect(st().scope).toEqual([]);
+    st().pressNode(id['make apparel']);
+    expect(st().actionsFor).toBeUndefined();
+    expect(st().scope).toEqual([id['make apparel']]);
+    expect(st().focus).toBe(id['make apparel']);
+    st().pressNode(id.sew);
+    expect(st().actionsFor).toBe(id.sew);
+    st().pressNode(id.draw);
+    expect(st().actionsFor).toBe(id.draw);
+    expect(st().focus).toBe(id.draw);
+  });
+
+  it('a second tap on a node nothing feeds just puts the actions away', () => {
+    const id = world();
+    st().pressNode(id.guitar);
+    st().pressNode(id.guitar);
+    expect(st().actionsFor).toBeUndefined();
+    expect(st().scope).toEqual([]);
+    expect(st().focus).toBe(id.guitar);
+  });
+
+  it('with the log field open a tap attaches, as before (P-61), and pops nothing up', () => {
+    const id = world();
+    useStore.setState({ homeFace: 'log' });
+    st().pressNode(id.sew);
+    expect(st().actionsFor).toBeUndefined();
+    expect(st().draft.toIds).toEqual([id.sew]);
+    expect(st().focus).toBe(id.sew);
+  });
+
+  it('the nub pops them up (focusing the node) and `undefined` puts them away; a hidden or unknown node does nothing', () => {
+    const id = world();
+    st().showActions(id.sew);
+    expect(st().actionsFor).toBe(id.sew);
+    expect(st().focus).toBe(id.sew);
+    st().showActions(undefined);
+    expect(st().actionsFor).toBeUndefined();
+    st().setHidden(id.guitar, true);
+    st().pressNode(id.guitar);
+    st().showActions(id.guitar);
+    st().pressNode('nope');
+    expect(st().actionsFor).toBeUndefined();
+    expect(st().focus).toBe(id.sew);
+  });
+});
