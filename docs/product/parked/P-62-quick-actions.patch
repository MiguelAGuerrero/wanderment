diff --git a/e2e/home-actions.spec.ts b/e2e/home-actions.spec.ts
new file mode 100644
index 0000000..8035e7e
--- /dev/null
+++ b/e2e/home-actions.spec.ts
@@ -0,0 +1,310 @@
+/** P-62 (D-11): quick actions on a node — a ＋ nub on every circle; selecting a node pops up its actions. */
+import { AxeBuilder } from '@axe-core/playwright';
+import { Locator, Page } from '@playwright/test';
+
+import { expect, test } from './fixtures';
+import { legacyBlob, seedScript } from './graphFixture';
+
+const SHOTS = process.env.E2E_SHOTS; // set to a folder to save screenshots for a visual check
+const DAY = 864e5;
+const BOX = 'What did you just do?';
+
+const node = (page: Page, id: string) => page.getByTestId(`graph-node-${id}`).filter({ visible: true });
+const nodes = (page: Page) => page.locator('[data-testid^="graph-node-"]').filter({ visible: true });
+const nub = (page: Page, name: string) => page.getByRole('button', { name: `Actions for ${name}`, exact: true });
+const nubs = (page: Page) => page.getByRole('button', { name: /^Actions for / }).filter({ visible: true });
+const menu = (page: Page) => page.getByRole('menu');
+const item = (page: Page, name: string) => menu(page).getByRole('menuitem', { name, exact: true });
+const plus = (page: Page) => page.getByRole('button', { name: 'Log something', exact: true });
+const box = (page: Page) => page.getByTestId('home-slot').locator(`input[aria-label="${BOX}"]`);
+const chip = (page: Page, kind: 'To' | 'Doing', name: string) => page.getByTestId('home-slot').getByRole('button', { name: `${kind}: ${name}. Remove`, exact: true });
+const card = (page: Page) => page.getByRole('region', { name: /^What’s next/ });
+const scopeChip = (page: Page) => page.getByTestId('scope-chip').filter({ visible: true });
+const rings = (page: Page) => page.locator('[data-testid^="graph-selected-"]').filter({ visible: true });
+
+async function expectNoSeriousViolations(page: Page) {
+  const { violations } = await new AxeBuilder({ page }).withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa']).analyze();
+  const serious = violations.filter((v) => v.impact === 'serious' || v.impact === 'critical');
+  const report = serious.map((v) => `${v.id}: ${v.help}\n  ${v.nodes.map((n) => `${n.target.join(' ')} ${n.html.slice(0, 200)}`).slice(0, 5).join('\n  ')}`);
+  expect(report, report.join('\n')).toEqual([]);
+}
+
+/**
+ * The owner's Home (2026-11-23): feel productive (declared, the card's node) with the staged step
+ * "Clean my car"; draw feeds it (no step); cook stands alone.
+ */
+function owner() {
+  const json = JSON.parse(
+    legacyBlob(['feel productive', 'draw', 'cook'], [
+      { from: 'draw', to: ['feel productive'], text: 'sketched', daysAgo: 20 },
+      { from: 'cook', text: 'cooked dinner', daysAgo: 4 },
+      { to: ['feel productive'], text: 'made the bed', daysAgo: 3 },
+    ]),
+  );
+  json.state.data.threads['feel productive'].declaredAt = new Date(Date.now() - 30 * DAY).toISOString();
+  json.state.data.threads['feel productive'].next = 'Clean my car';
+  return JSON.stringify(json);
+}
+
+async function open(page: Page, picture = true) {
+  await page.addInitScript(seedScript, owner());
+  await page.goto('./');
+  await expect(plus(page)).toBeVisible();
+  if (picture) await expect(nodes(page)).toHaveCount(3);
+}
+
+const centre = async (l: Locator) => {
+  const b = (await l.boundingBox())!;
+  return { x: b.x + b.width / 2, y: b.y + b.height / 2, w: b.width, h: b.height };
+};
+const circle = (page: Page, id: string) => page.getByTestId(`graph-circle-${id}`).filter({ visible: true });
+const overlaps = (a: { x: number; y: number; width: number; height: number }, b: { x: number; y: number; width: number; height: number }) =>
+  a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height;
+
+test.describe('at 390 px', () => {
+  test.use({ viewport: { width: 390, height: 844 } });
+  test.beforeEach(async ({ page }) => open(page));
+
+  test('every circle has a small ＋ nub sticking out of its edge, a 44 pt button “Actions for <node>”; circles keep their names', async ({ page }) => {
+    await expect(nubs(page)).toHaveCount(3);
+    for (const [id, name] of [
+      ['feel productive', 'feel productive, what it’s for'],
+      ['draw', 'draw, a wander'],
+      ['cook', 'cook, a wander'],
+    ]) {
+      await expect(node(page, id)).toHaveAccessibleName(name);
+      const n = nub(page, id);
+      await expect(n).toBeVisible();
+      await expect(n).toHaveAttribute('aria-expanded', 'false');
+      const hit = (await n.boundingBox())!;
+      expect(hit.width).toBeGreaterThanOrEqual(44);
+      expect(hit.height).toBeGreaterThanOrEqual(44);
+      // The disc (about 20 pt) overlaps the circle's edge: its centre just outside it.
+      const disc = await centre(n.locator('div').first());
+      expect(disc.w).toBeGreaterThanOrEqual(18);
+      expect(disc.w).toBeLessThanOrEqual(22);
+      const c = await centre(circle(page, id));
+      const d = Math.hypot(disc.x - c.x, disc.y - c.y);
+      expect(d).toBeGreaterThan(c.w / 2);
+      expect(d - disc.w / 2).toBeLessThan(c.w / 2);
+    }
+    await expect(menu(page)).toHaveCount(0);
+    await expectNoSeriousViolations(page);
+    if (SHOTS) await page.screenshot({ path: `${SHOTS}/p62-1-nubs.png` });
+  });
+
+  test('a tap on a circle focuses it and pops up its actions beside it, focus inside; they cover no other circle', async ({ page }) => {
+    await node(page, 'draw').click();
+    await expect(rings(page)).toHaveAttribute('data-testid', 'graph-selected-draw');
+    await expect(card(page)).toContainText('What’s next · draw');
+    await expect(menu(page)).toHaveAccessibleName('Actions for draw');
+    await expect(menu(page).getByRole('menuitem')).toHaveText(['→Log toward it', '＋Under it', '•Add a step', '↗Open']);
+    for (const name of ['Log toward it', 'Under it', 'Add a step', 'Open']) {
+      const b = (await item(page, name).boundingBox())!;
+      expect(b.height).toBeGreaterThanOrEqual(44);
+      expect(b.width).toBeGreaterThanOrEqual(44);
+    }
+    await expect(item(page, 'Log toward it')).toBeFocused();
+    await expect(nub(page, 'draw')).toHaveAttribute('aria-expanded', 'true');
+    // On screen, and clear of the other circles.
+    const m = (await menu(page).boundingBox())!;
+    expect(m.x).toBeGreaterThanOrEqual(0);
+    expect(m.x + m.width).toBeLessThanOrEqual(390);
+    for (const id of ['feel productive', 'cook']) expect(overlaps(m, (await circle(page, id).boundingBox())!)).toBe(false);
+    // Nothing attached by the tap; the log field stays away.
+    await expect(box(page)).toBeHidden();
+    await expectNoSeriousViolations(page);
+  });
+
+  test('the nub pops up the same actions (feel productive has a step: no “Add a step”); again puts them away', async ({ page }) => {
+    await nub(page, 'feel productive').click();
+    await expect(menu(page)).toHaveAccessibleName('Actions for feel productive');
+    await expect(menu(page).getByRole('menuitem')).toHaveText(['→Log toward it', '＋Under it', '↗Open']);
+    await expect(rings(page)).toHaveAttribute('data-testid', 'graph-selected-feel productive');
+    // Not narrowed, though something feeds it.
+    await expect(scopeChip(page)).toHaveCount(0);
+    if (SHOTS) await page.screenshot({ path: `${SHOTS}/p62-2-menu.png` });
+    await nub(page, 'feel productive').click();
+    await expect(menu(page)).toHaveCount(0);
+  });
+
+  test('Log toward it: the log field opens with the node attached (a chip), keyboard in it; the log goes there', async ({ page }) => {
+    await node(page, 'feel productive').click();
+    await item(page, 'Log toward it').click();
+    await expect(menu(page)).toHaveCount(0);
+    await expect(box(page)).toBeVisible();
+    await expect(box(page)).toBeFocused();
+    await expect(chip(page, 'To', 'feel productive')).toBeVisible();
+    await box(page).fill('swept the floor');
+    await box(page).press('Enter');
+    await expect(page.getByText('Logged → feel productive', { exact: true })).toBeVisible();
+  });
+
+  test('＋ Under it: a name field in place of the actions; Return makes the wander and opens the log field with it as doing and this node as to; the first log draws the branch', async ({ page }) => {
+    await node(page, 'feel productive').click();
+    await item(page, 'Under it').click();
+    const field = page.getByRole('textbox', { name: 'New wander under feel productive', exact: true });
+    await expect(field).toBeFocused();
+    await expect(menu(page)).toHaveCount(0);
+    await expectNoSeriousViolations(page);
+    if (SHOTS) await page.screenshot({ path: `${SHOTS}/p62-3-under.png` });
+    await field.fill('tidy the desk');
+    await field.press('Enter');
+    await expect(field).toHaveCount(0);
+    await expect(box(page)).toBeFocused();
+    await expect(chip(page, 'Doing', 'tidy the desk')).toBeVisible();
+    await expect(chip(page, 'To', 'feel productive')).toBeVisible();
+    // Made, but nothing logged yet: it stands on its own (a branch is never stored, only drawn from logs).
+    const fresh = page.getByRole('button', { name: 'tidy the desk, a wander', exact: true });
+    await expect(fresh).toBeVisible();
+    await expect(fresh).not.toHaveAttribute('data-under', /./);
+    await box(page).fill('cleared the desk');
+    await box(page).press('Enter');
+    await expect(page.getByText('Logged → feel productive', { exact: true })).toBeVisible();
+    const id = (await fresh.getAttribute('data-testid'))!.replace('graph-node-', '');
+    await expect(page.getByTestId(`graph-link-${id}-feel productive`)).toHaveCount(1);
+    await expect(fresh).toHaveAttribute('data-under', 'feel productive');
+  });
+
+  test('Add a step: the card’s field for that node, focused; Return stages it', async ({ page }) => {
+    await node(page, 'draw').click();
+    await item(page, 'Add a step').click();
+    await expect(menu(page)).toHaveCount(0);
+    const field = card(page).getByRole('textbox', { name: 'What’s next for draw', exact: true });
+    await expect(field).toBeFocused();
+    await field.fill('ink a hand');
+    await field.press('Enter');
+    await expect(card(page)).toContainText('ink a hand');
+  });
+
+  test('Open: the wander’s page', async ({ page }) => {
+    await node(page, 'cook').click();
+    await item(page, 'Open').click();
+    await expect(page).toHaveURL(/\/thread\/cook$/);
+  });
+
+  test('a tap outside, Esc, or selecting another node puts them away; Esc hands focus back', async ({ page }) => {
+    await node(page, 'draw').click();
+    await expect(menu(page)).toBeVisible();
+    await page.getByRole('heading', { name: 'Wanderment' }).click();
+    await expect(menu(page)).toHaveCount(0);
+    // Focus stays where it was; nothing else changed.
+    await expect(rings(page)).toHaveAttribute('data-testid', 'graph-selected-draw');
+
+    await node(page, 'draw').click();
+    await expect(item(page, 'Log toward it')).toBeFocused();
+    await page.keyboard.press('Escape');
+    await expect(menu(page)).toHaveCount(0);
+    await expect(node(page, 'draw')).toBeFocused();
+
+    await nub(page, 'draw').click();
+    await page.keyboard.press('Escape');
+    await expect(menu(page)).toHaveCount(0);
+    await expect(nub(page, 'draw')).toBeFocused();
+
+    await node(page, 'draw').click();
+    await node(page, 'cook').click();
+    await expect(menu(page)).toHaveAccessibleName('Actions for cook');
+    await expect(rings(page)).toHaveAttribute('data-testid', 'graph-selected-cook');
+    // The ＋ to log, outside: away, and the field opens.
+    await plus(page).click();
+    await expect(menu(page)).toHaveCount(0);
+    await expect(box(page)).toBeFocused();
+  });
+
+  test('a second tap on a focused parent narrows and puts them away; Back puts them away (and goes up, as before)', async ({ page }) => {
+    await node(page, 'feel productive').click();
+    await expect(menu(page)).toBeVisible();
+    await expect(scopeChip(page)).toHaveCount(0);
+    await node(page, 'feel productive').click();
+    await expect(menu(page)).toHaveCount(0);
+    await expect(scopeChip(page)).toHaveText('‹ All · feel productive');
+    // Narrowed, the nubs are there too.
+    await expect(nubs(page)).toHaveCount(2);
+    await node(page, 'draw').click();
+    await expect(menu(page)).toHaveAccessibleName('Actions for draw');
+    await page.goBack();
+    await expect(menu(page)).toHaveCount(0);
+    await expect(scopeChip(page)).toHaveCount(0);
+    await expect(page).toHaveURL(/\/wanderment\/$/);
+  });
+
+  test('Esc in a scope puts the actions away first, then goes up', async ({ page }) => {
+    await node(page, 'feel productive').click();
+    await node(page, 'feel productive').click();
+    await expect(scopeChip(page)).toBeVisible();
+    await node(page, 'draw').click();
+    await expect(menu(page)).toBeVisible();
+    await page.keyboard.press('Escape');
+    await expect(menu(page)).toHaveCount(0);
+    await expect(scopeChip(page)).toBeVisible();
+    await page.keyboard.press('Escape');
+    await expect(scopeChip(page)).toHaveCount(0);
+  });
+
+  test('a swipe on the card moves focus and pops nothing up', async ({ page }) => {
+    const b = (await card(page).getByText('Clean my car', { exact: true }).boundingBox())!;
+    const [x, y] = [b.x + b.width / 2, b.y + b.height / 2];
+    await page.mouse.move(x, y);
+    await page.mouse.down();
+    await page.mouse.move(x - 80, y + 2, { steps: 10 });
+    await page.mouse.up();
+    await expect(card(page)).not.toContainText('What’s next · feel productive');
+    await expect(menu(page)).toHaveCount(0);
+  });
+
+  test('keyboard: Tab to a nub, Enter pops up the menu with focus on its first item, arrows move, Esc returns to the nub', async ({ page }) => {
+    await nub(page, 'cook').focus();
+    await page.keyboard.press('Enter');
+    await expect(item(page, 'Log toward it')).toBeFocused();
+    await page.keyboard.press('ArrowRight');
+    await expect(item(page, 'Under it')).toBeFocused();
+    await page.keyboard.press('End');
+    await expect(item(page, 'Open')).toBeFocused();
+    await page.keyboard.press('ArrowRight');
+    await expect(item(page, 'Log toward it')).toBeFocused();
+    await page.keyboard.press('Escape');
+    await expect(menu(page)).toHaveCount(0);
+    await expect(nub(page, 'cook')).toBeFocused();
+    // The circle itself, by keyboard.
+    await node(page, 'cook').focus();
+    await page.keyboard.press('Enter');
+    await expect(item(page, 'Log toward it')).toBeFocused();
+  });
+
+  test('with the log field open a tap attaches, as before (P-61), and pops nothing up', async ({ page }) => {
+    await plus(page).click();
+    await expect(box(page)).toBeFocused();
+    await node(page, 'cook').click();
+    await expect(chip(page, 'To', 'cook')).toBeVisible();
+    await expect(menu(page)).toHaveCount(0);
+  });
+});
+
+test.describe('at 200 % zoom (195 px: the list)', () => {
+  test.use({ viewport: { width: 195, height: 422 } });
+  test.beforeEach(async ({ page }) => open(page, false));
+
+  test('a list item opens the same actions (no nubs); they work and Esc hands focus back; no serious violations', async ({ page }) => {
+    const list = page.getByTestId('home-graph-list');
+    await expect(list).toBeVisible();
+    await expect(nubs(page)).toHaveCount(0);
+    const draw = list.getByRole('button', { name: 'draw, a wander', exact: true });
+    await draw.click();
+    await expect(menu(page)).toHaveAccessibleName('Actions for draw');
+    await expect(item(page, 'Log toward it')).toBeFocused();
+    await expect(draw).toHaveAttribute('aria-expanded', 'true');
+    const m = (await menu(page).boundingBox())!;
+    expect(m.x).toBeGreaterThanOrEqual(0);
+    expect(m.x + m.width).toBeLessThanOrEqual(195);
+    await expectNoSeriousViolations(page);
+    if (SHOTS) await page.screenshot({ path: `${SHOTS}/p62-4-list-200.png`, fullPage: true });
+    await page.keyboard.press('Escape');
+    await expect(menu(page)).toHaveCount(0);
+    await expect(draw).toBeFocused();
+    await draw.click();
+    await item(page, 'Log toward it').click();
+    await expect(box(page)).toBeFocused();
+    await expect(chip(page, 'To', 'draw')).toBeVisible();
+  });
+});
