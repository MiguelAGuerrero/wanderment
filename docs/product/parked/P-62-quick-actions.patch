@@ -0,0 +1,105 @@
+/**
+ * P-46 (with P-62): what Home's picture needs from every log, kept up to date a log at a time. Home
+ * redraws after every log, and with a big history going through every log again each time is most of
+ * the picture's cost; a log only adds one record, so when the new activities are the old ones plus a
+ * few, only those few are added. Anything else (an edit, a removal, an import) builds it again.
+ * Nothing here is stored.
+ */
+import { emptyHeatIndex, HeatIndex, indexHeat } from './heat';
+import { Activity, Id } from './types';
+
+/** How many of each wander's newest logs are kept (the picture's dots never need more). */
+export const TOP_PER_THREAD = 8;
+
+export interface ActivityIndex {
+  /** The activities this was worked out from. */
+  acts: Record<Id, Activity>;
+  count: number;
+  /** All-time logs per wander (as doing, or as a "to" that isn't its doing). */
+  steps: Map<Id, number>;
+  /** doing → to (a different wander) → how many logs. */
+  pairs: Map<Id, Map<Id, number>>;
+  /** Logs with no doing, per "to". */
+  direct: Map<Id, number>;
+  /** Per wander, its newest logs (doing or to), newest first (`newer`), at most TOP_PER_THREAD. */
+  top: Map<Id, Activity[]>;
+  /** P-48's heat index (each wander's newest log, and who feeds whom). */
+  heat: HeatIndex;
+  /** Logs that name no wander (no doing, no to). */
+  loose: Activity[];
+}
+
+const cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
+/** Newest first: by when it was logged, then id (as `overview`'s dots). */
+export const newer = (a: Activity, b: Activity) => cmp(b.createdAt, a.createdAt) || cmp(b.id, a.id);
+
+function add(ix: ActivityIndex, a: Activity) {
+  indexHeat(ix.heat, a);
+  if (!a.doingId && !a.toIds.length) ix.loose.push(a);
+  const named: Id[] = [];
+  if (a.doingId) {
+    ix.steps.set(a.doingId, (ix.steps.get(a.doingId) ?? 0) + 1);
+    named.push(a.doingId);
+  }
+  for (const to of a.toIds) {
+    if (!named.includes(to)) named.push(to);
+    if (to === a.doingId) continue;
+    ix.steps.set(to, (ix.steps.get(to) ?? 0) + 1);
+    if (!a.doingId) ix.direct.set(to, (ix.direct.get(to) ?? 0) + 1);
+    else {
+      const m = ix.pairs.get(a.doingId) ?? ix.pairs.set(a.doingId, new Map()).get(a.doingId)!;
+      m.set(to, (m.get(to) ?? 0) + 1);
+    }
+  }
+  for (const id of named) {
+    const list = ix.top.get(id) ?? ix.top.set(id, []).get(id)!;
+    if (list.length === TOP_PER_THREAD && newer(a, list[TOP_PER_THREAD - 1]) > 0) continue;
+    let i = list.length;
+    while (i > 0 && newer(a, list[i - 1]) < 0) i--;
+    list.splice(i, 0, a);
+    if (list.length > TOP_PER_THREAD) list.pop();
+  }
+}
+
+/** Built from scratch. */
+export function buildActivityIndex(acts: Record<Id, Activity>): ActivityIndex {
+  const ix: ActivityIndex = { acts, count: 0, steps: new Map(), pairs: new Map(), direct: new Map(), top: new Map(), heat: emptyHeatIndex(), loose: [] };
+  for (const id in acts) {
+    add(ix, acts[id]);
+    ix.count++;
+  }
+  return ix;
+}
+
+let last: ActivityIndex | undefined;
+
+/**
+ * The index for these activities: the last one as it is (the same activities), brought up to date
+ * (the same records plus new ones), or built again.
+ */
+export function activityIndex(acts: Record<Id, Activity>): ActivityIndex {
+  if (last?.acts === acts) return last;
+  if (last) {
+    const old = last.acts;
+    const added: Activity[] = [];
+    let kept = 0;
+    let same = true;
+    for (const id in acts) {
+      const o = Object.prototype.hasOwnProperty.call(old, id) ? old[id] : undefined;
+      if (o === undefined) added.push(acts[id]);
+      else if (o !== acts[id]) {
+        same = false;
+        break;
+      } else kept++;
+    }
+    // Every old record still there and untouched: just add the new ones (in place: only the latest index is ever used).
+    if (same && kept === last.count) {
+      for (const a of added) add(last, a);
+      last.acts = acts;
+      last.count += added.length;
+      return last;
+    }
+  }
+  last = buildActivityIndex(acts);
+  return last;
+}
